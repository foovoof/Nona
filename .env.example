# ── Supabase ─────────────────────────────────────────────────────────────────
# Public / anon key (used in browser + SSR)
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>

# Server-side env vars (not exposed to browser)
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Telegram Bot Tokens ───────────────────────────────────────────────────────
TELEGRAM_RIDER_BOT_TOKEN=<rider-bot-token>
TELEGRAM_DRIVER_BOT_TOKEN=<driver-bot-token>
TELEGRAM_SUPPORT_CHAT_ID=<support-group-chat-id>

# ── Mapbox ────────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=<mapbox-public-token>

# ── AI (Lovable / OpenAI-compatible Gateway) ─────────────────────────────────
LOVABLE_API_KEY=<lovable-api-key>

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=<random-32-char-string>

# ── Field encryption (phones at rest) ────────────────────────────────────────
# openssl rand -hex 32 — NEVER rotate without re-encrypting otp_challenges/profiles
PHONE_ENCRYPTION_KEY=<64-hex-chars>

# ── Cron authenticity (HMAC over the raw request body) ───────────────────────
# openssl rand -hex 32
CRON_SECRET=<64-hex-chars>

# ── Telegram webhook hardening ───────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET=<secret-token-set-via-setWebhook>
TELEGRAM_ENFORCE_IP_ALLOWLIST=false

# ── OTP delivery: SMS (1st choice) ───────────────────────────────────────────
SMS_API_ENDPOINT=https://api.<sms-provider>.com/v1/messages
SMS_API_KEY=<sms-api-key>
SMS_SENDER_ID=NONA

# ── OTP delivery: WhatsApp Cloud API (2nd choice) ────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
WHATSAPP_ACCESS_TOKEN=<permanent-access-token>
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_OTP_LANGUAGE=ar
# 3rd choice is Telegram, which needs no extra config.
